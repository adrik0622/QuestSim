; Disposable launch scaffold; no presentation selected.
config_version=5

[application]
config/name="QuestSim Presentation Lab"
run/main_scene="res://Bootstrap.tscn"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=540

[dotnet]
project/assembly_name="QuestSim.Presentation"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
